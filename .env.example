# Copie para .env e ajuste:  cp .env.example .env
# O .env NUNCA vai para o Git (está no .gitignore). Este arquivo é o "contrato":
# diz quais variáveis existem, sem conter segredos reais.

# --- Banco de dados ---
POSTGRES_USER=reserva
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=reserva_salas
# Os testes criam e usam um banco SEPARADO: <POSTGRES_DB>_test (reserva_salas_test).

# --- Autenticação (JWT) ---
# Gere a sua com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Mínimo de 32 caracteres: a API NÃO sobe com o valor abaixo (de propósito).
SECRET_KEY=TROQUE-POR-UMA-CHAVE-GERADA
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
# Front-ends autorizados a chamar a API pelo navegador (formato JSON).
# 5173 é a porta do serviço "web" do docker-compose.
CORS_ORIGINS=["http://localhost:5173"]

# --- Seed (dados de demonstração: python -m app.scripts.seed) ---
# Admin inicial. Troque a senha antes de usar fora da sua máquina.
SEED_ADMIN_EMAIL=admin@empresa.com
SEED_ADMIN_SENHA=troque-esta-senha-admin
# Senha dos usuários de demonstração (rita, ana e bruno @empresa.com).
SEED_SENHA_DEMO=senha-demo-123
