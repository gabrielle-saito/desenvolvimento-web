# Copie para .env e ajuste:  cp .env.example .env
# O .env NUNCA vai para o Git (está no .gitignore). Este arquivo é o "contrato":
# diz quais variáveis existem, sem conter segredos reais.

# --- Banco de dados ---
POSTGRES_USER=agro
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=agroemergia

# --- Autenticação (JWT) ---
# Gere a sua com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Mínimo de 32 caracteres: a API NÃO sobe com o valor abaixo (de propósito).
SECRET_KEY=TROQUE-POR-UMA-CHAVE-GERADA
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
# Front-ends autorizados a chamar a API pelo navegador (formato JSON).
CORS_ORIGINS=["http://localhost:5173"]
