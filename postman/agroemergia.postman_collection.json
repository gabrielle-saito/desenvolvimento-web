    {
      "name": "2. Autenticação",
      "item": [
        {
          "name": "Registrar usuária (Ana)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Corpo em JSON. A resposta nunca devolve a senha nem o hash."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 201 na primeira vez; 409 se você rodar de novo (e-mail já existe).",
                  "pm.test(\"201 ou 409\", () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  pm.test(\"resposta não expõe senha nem hash\", () => {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b).to.not.have.property(\"password\");",
                  "    pm.expect(b).to.not.have.property(\"hashed_password\");",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (Ana) — salva o token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{email}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "ATENÇÃO: o login é x-www-form-urlencoded (padrão OAuth2), não JSON. O campo se chama username, mas recebe o e-mail."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "// Guarda o token no environment: as próximas requisições usam {{token}}.",
                  "pm.environment.set(\"token\", body.access_token);",
                  "pm.test(\"token salvo\", () => pm.expect(body.access_token).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Quem sou eu (/auth/me)",
